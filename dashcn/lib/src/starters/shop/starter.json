{
  "id": "shop",
  "type": "starter",
  "name": "Shop starter",
  "description": "Auth into a product grid with cart checkout and settings.",
  "themePreset": "neutral",
  "platforms": ["ios", "android", "web", "macos", "windows", "linux"],
  "flows": ["auth-01", "checkout-01", "settings-01"],
  "blocks": [],
  "components": ["app", "navigation_bar", "card", "badge", "button", "image"],
  "routes": [
    {"path": "/signin", "title": "Sign in", "kind": "flow", "ref": "auth-01"},
    {"path": "/shop", "title": "Shop", "kind": "page", "ref": "product-grid"},
    {"path": "/cart", "title": "Cart", "kind": "flow", "ref": "checkout-01"},
    {"path": "/settings", "title": "Settings", "kind": "flow", "ref": "settings-01"}
  ],
  "files": [
    {"template": "starters/shop/templates/lib/main.dart.tmpl", "target": "lib/main.dart"},
    {"template": "starters/shop/templates/lib/app.dart.tmpl", "target": "lib/app.dart"},
    {"template": "starters/shop/templates/lib/data/repository.dart.tmpl", "target": "lib/data/repository.dart"},
    {"template": "starters/shop/templates/lib/shop/product_grid.dart.tmpl", "target": "lib/shop/product_grid.dart"},
    {"template": "starters/shop/templates/lib/shell.dart.tmpl", "target": "lib/shell.dart"},
    {"template": "starters/shop/templates/test/smoke_test.dart.tmpl", "target": "test/smoke_test.dart"}
  ],
  "tags": ["shop", "auth", "checkout", "cart", "settings"],
  "install": "dashcn create shop my_app"
}
