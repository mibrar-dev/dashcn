// Smoke test for the shop starter ({{appName}}).
//
// Walks the main routes: sign in (plus OTP) to the tabs, add to cart, then
// cart and settings.
import 'package:flutter/widgets.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:{{packageName}}/app.dart';

void main() {
  testWidgets('shop smoke: sign in, add to cart, walk tabs', (
    WidgetTester tester,
  ) async {
    await tester.pumpWidget(const ShopApp());
    await tester.pumpAndSettle();

    expect(find.text('Sign in'), findsWidgets);
    await tester.enterText(
      find.byKey(const ValueKey<String>('auth01.signin.email')),
      'ada@example.com',
    );
    await tester.enterText(
      find.byKey(const ValueKey<String>('auth01.signin.password')),
      'password123',
    );
    await tester.tap(find.text('Sign in').last);
    await tester.pumpAndSettle();

    await tester.enterText(
      find.byKey(const ValueKey<String>('auth01.otp.code')),
      '123456',
    );
    await tester.pumpAndSettle();

    expect(find.byKey(const ValueKey<String>('shop.shell')), findsOneWidget);
    expect(
      find.byKey(const ValueKey<String>('shop.page.shop')),
      findsOneWidget,
    );

    // Add the first product to the app cart.
    await tester.tap(find.byKey(const ValueKey<String>('shop.add.backpack')));
    await tester.pumpAndSettle();

    // Cart tab shows the checkout flow.
    await tester.tap(find.byKey(const ValueKey<String>('shop.tab.cart')));
    await tester.pumpAndSettle();
    expect(
      find.byKey(const ValueKey<String>('shop.page.cart')),
      findsOneWidget,
    );

    // Settings tab.
    await tester.tap(find.byKey(const ValueKey<String>('shop.tab.settings')));
    await tester.pumpAndSettle();
    expect(
      find.byKey(const ValueKey<String>('shop.page.settings')),
      findsOneWidget,
    );
  });
}
