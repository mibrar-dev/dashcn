// Product grid for the shop starter.
//
// Built in the starter from components (card, badge, button, picture); there
// is deliberately no new kit block for this grid.
{{imports}}
import '../data/repository.dart';

/// Grid of catalogue cards with an add-to-cart action per product.
class ProductGrid extends StatelessWidget {
  /// Creates the grid.
  const ProductGrid({super.key, required this.repository});

  /// App-owned catalogue plus cart.
  final ShopRepository repository;

  @override
  Widget build(BuildContext context) {
    return ListView(
      key: const ValueKey<String>('shop.page.grid'),
      padding: const EdgeInsets.all(16),
      children: <Widget>[
        for (final ShopProduct product in repository.products)
          Padding(
            padding: const EdgeInsets.only(bottom: 12),
            child: Card(
              child: Padding(
                padding: const EdgeInsets.all(16),
                child: Row(
                  children: <Widget>[
                    Picture(
                      image: NetworkImage(
                        'https://example.com/${product.id}.png',
                      ),
                      width: 64,
                      height: 64,
                      placeholder: Center(
                        child: Text(
                          product.name.characters.first,
                          style: const TextStyle(fontSize: 24),
                        ),
                      ),
                      errorBuilder:
                          (
                            BuildContext context,
                            Object error,
                            StackTrace? stackTrace,
                          ) => Center(
                            child: Text(
                              product.name.characters.first,
                              style: const TextStyle(fontSize: 24),
                            ),
                          ),
                    ),
                    const SizedBox(width: 12),
                    Expanded(
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: <Widget>[
                          Row(
                            children: <Widget>[
                              Expanded(child: Text(product.name)),
                              Badge(
                                child: Text(product.tag),
                              ),
                            ],
                          ),
                          const SizedBox(height: 4),
                          Text('\$${product.price.toStringAsFixed(0)}'),
                          const SizedBox(height: 8),
                          Button(
                            key: ValueKey<String>(
                              'shop.add.${product.id}',
                            ),
                            size: ButtonSize.sm,
                            onPressed: () =>
                                repository.addToCart(product),
                            child: const Text('Add to cart'),
                          ),
                        ],
                      ),
                    ),
                  ],
                ),
              ),
            ),
          ),
      ],
    );
  }
}
