// Tab bar shell for the shop starter.
//
// Shop (starter grid), cart (checkout flow fed from the app cart) and
// settings. The grid and checkout meet only through [ShopRepository].
{{imports}}
import 'shop/product_grid.dart';
import 'data/repository.dart';

/// Shell with shop, cart and settings tabs.
class ShopShell extends StatefulWidget {
  /// Creates the shell.
  const ShopShell({super.key, required this.repository});

  /// App-owned catalogue plus cart.
  final ShopRepository repository;

  @override
  State<ShopShell> createState() => _ShopShellState();
}

class _ShopShellState extends State<ShopShell> {
  int _index = 0;

  List<NavigationBarItem> get _items => const <NavigationBarItem>[
    NavigationItem(
      key: ValueKey<String>('shop.tab.shop'),
      label: Text('Shop'),
      child: Icon(RadixIcons.home),
    ),
    NavigationItem(
      key: ValueKey<String>('shop.tab.cart'),
      label: Text('Cart'),
      child: Icon(RadixIcons.cardStack),
    ),
    NavigationItem(
      key: ValueKey<String>('shop.tab.settings'),
      label: Text('Settings'),
      child: Icon(RadixIcons.gear),
    ),
  ];

  Widget _page(int index) {
    switch (index) {
      case 0:
        return ProductGrid(
          key: const ValueKey<String>('shop.page.shop'),
          repository: widget.repository,
        );
      case 1:
        return Checkout01Flow(
          key: const ValueKey<String>('shop.page.cart'),
          items: <Checkout01CartItem>[
            for (final ShopCartRow row in widget.repository.cart)
              Checkout01CartItem(
                name: row.name,
                price: row.price,
                quantity: row.quantity,
              ),
          ],
        );
      case 2:
      default:
        return Settings01Flow(
          key: const ValueKey<String>('shop.page.settings'),
          onSignOut: widget.repository.signOut,
        );
    }
  }

  @override
  Widget build(BuildContext context) {
    return Column(
      key: const ValueKey<String>('shop.shell'),
      children: <Widget>[
        Expanded(child: _page(_index)),
        NavigationBar(
          key: const ValueKey<String>('shop.nav'),
          index: _index,
          onSelected: (int value) => setState(() => _index = value),
          children: _items,
        ),
      ],
    );
  }
}
