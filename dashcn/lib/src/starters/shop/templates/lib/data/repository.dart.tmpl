// App-owned state for the shop starter.
//
// REPLACE WITH YOUR BACKEND: this in-memory repository exists so the
// generated app runs without a server. Swap its methods for real calls.
import 'package:flutter/widgets.dart';

/// One product of the starter grid.
class ShopProduct {
  /// Creates a product.
  const ShopProduct({
    required this.id,
    required this.name,
    required this.price,
    required this.tag,
  });

  /// Stable id.
  final String id;

  /// Display name.
  final String name;

  /// Unit price.
  final double price;

  /// Badge label (for example `New` or `-20%`).
  final String tag;
}

/// One cart row (mirrors the checkout flow shape).
class ShopCartRow {
  /// Creates a cart row.
  ShopCartRow({required this.name, required this.price, this.quantity = 1});

  /// Display name.
  final String name;

  /// Unit price.
  final double price;

  /// Units in the cart.
  int quantity;
}

/// Minimal auth plus cart state for the shop starter.
class ShopRepository extends ChangeNotifier {
  /// Whether the OTP step completed.
  bool signedIn = false;

  /// Last signed-in email, for display only.
  String? email;

  /// Catalogue shown by the product grid.
  final List<ShopProduct> products = const <ShopProduct>[
    ShopProduct(id: 'backpack', name: 'Everyday backpack', price: 89, tag: 'New'),
    ShopProduct(id: 'bottle', name: 'Insulated bottle', price: 32, tag: '-20%'),
    ShopProduct(id: 'lamp', name: 'Desk lamp', price: 54, tag: 'Best seller'),
    ShopProduct(id: 'chair', name: 'Studio chair', price: 199, tag: 'New'),
  ];

  /// Cart rows owned by the app.
  final List<ShopCartRow> cart = <ShopCartRow>[];

  /// Called with a valid sign-in form; the flow shows OTP next.
  Future<void> signIn(String email, String password) async {
    this.email = email;
  }

  /// Called with a valid sign-up form; the flow shows OTP next.
  Future<void> signUp(String name, String email, String password) async {
    this.email = email;
  }

  /// Called when a full OTP code completes.
  Future<void> verifyOtp(String code) async {}

  /// Called after the OTP step; moves the app to the tab bar.
  void completeAuth() {
    signedIn = true;
    notifyListeners();
  }

  /// Adds one unit of [product] to the cart.
  void addToCart(ShopProduct product) {
    for (final ShopCartRow row in cart) {
      if (row.name == product.name) {
        row.quantity++;
        notifyListeners();
        return;
      }
    }
    cart.add(ShopCartRow(name: product.name, price: product.price));
    notifyListeners();
  }

  /// Called from settings sign-out.
  void signOut() {
    signedIn = false;
    email = null;
    notifyListeners();
  }
}
