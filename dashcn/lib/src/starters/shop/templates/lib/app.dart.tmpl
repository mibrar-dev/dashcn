// Root widget for the shop starter ({{appName}}).
//
// Auth first, then a tab bar with shop, cart and settings. The grid writes
// into [ShopRepository]; the checkout flow reads the cart through data plus
// callbacks. The kit holds no backend.
{{imports}}
import 'data/repository.dart';
import 'shell.dart';

/// Auth gate plus theme for the generated app.
class ShopApp extends StatefulWidget {
  /// Creates the app.
  const ShopApp({super.key});

  @override
  State<ShopApp> createState() => _ShopAppState();
}

class _ShopAppState extends State<ShopApp> {
  late final ShopRepository _repository = ShopRepository()
    ..addListener(_onChanged);

  void _onChanged() => setState(() {});

  @override
  void dispose() {
    _repository.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return DashcnApp(
      title: '{{appName}}',
      theme: {{themeBuild}}(Brightness.light),
      darkTheme: {{themeBuild}}(Brightness.dark),
      home: _home(),
    );
  }

  Widget _home() {
    if (!_repository.signedIn) {
      return Auth01Flow(
        onSignIn: (String email, String password) =>
            _repository.signIn(email, password),
        onSignUp: (String name, String email, String password) =>
            _repository.signUp(name, email, password),
        onVerifyOtp: (String code) => _repository.verifyOtp(code),
        onResetPassword: (String email) async {},
        onSocialSignIn: (String provider) async {},
        onOtpVerified: _repository.completeAuth,
      );
    }
    return ShopShell(repository: _repository);
  }
}
