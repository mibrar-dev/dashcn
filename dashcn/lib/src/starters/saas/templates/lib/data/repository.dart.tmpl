// App-owned state for the saas starter.
//
// REPLACE WITH YOUR BACKEND: this in-memory repository exists so the
// generated app runs without a server. Swap its methods for real calls.
import 'package:flutter/widgets.dart';

/// Minimal auth plus onboarding state for the saas starter.
class SaasRepository extends ChangeNotifier {
  /// Whether the OTP step completed.
  bool signedIn = false;

  /// Whether onboarding resolved (finished or skipped).
  bool onboarded = false;

  /// Last signed-in email, for display only.
  String? email;

  /// Called with a valid sign-in form; the flow shows OTP next.
  Future<void> signIn(String email, String password) async {
    this.email = email;
  }

  /// Called with a valid sign-up form; the flow shows OTP next.
  Future<void> signUp(String name, String email, String password) async {
    this.email = email;
  }

  /// Called when a full OTP code completes.
  Future<void> verifyOtp(String code) async {}

  /// Called after the OTP step; moves the app to onboarding.
  void completeAuth() {
    signedIn = true;
    notifyListeners();
  }

  /// Called when the permission screen resolves.
  void completeOnboarding(bool granted) {
    onboarded = true;
    notifyListeners();
  }

  /// Called when Skip is tapped.
  void skipOnboarding() {
    onboarded = true;
    notifyListeners();
  }

  /// Called from settings sign-out.
  void signOut() {
    signedIn = false;
    onboarded = false;
    email = null;
    notifyListeners();
  }
}
