// Responsive shell for the saas starter.
//
// Wide screens get a sidebar rail; narrow screens get a bottom tab bar. The
// three tabs host dashboard-01, pricing-01 and settings-01 with real
// callbacks into the app repository.
{{imports}}
import 'data/repository.dart';

/// Shell with dashboard, pricing and settings tabs.
class SaasShell extends StatefulWidget {
  /// Creates the shell.
  const SaasShell({super.key, required this.repository});

  /// App-owned state; sign-out flips it back to the auth flow.
  final SaasRepository repository;

  @override
  State<SaasShell> createState() => _SaasShellState();
}

class _SaasShellState extends State<SaasShell> {
  int _index = 0;

  List<NavigationBarItem> get _items => const <NavigationBarItem>[
    NavigationItem(
      key: ValueKey<String>('saas.tab.dashboard'),
      label: Text('Dashboard'),
      child: Icon(RadixIcons.home),
    ),
    NavigationItem(
      key: ValueKey<String>('saas.tab.pricing'),
      label: Text('Pricing'),
      child: Icon(RadixIcons.cardStack),
    ),
    NavigationItem(
      key: ValueKey<String>('saas.tab.settings'),
      label: Text('Settings'),
      child: Icon(RadixIcons.gear),
    ),
  ];

  Widget _page(int index) {
    switch (index) {
      case 0:
        return const Dashboard01(key: ValueKey<String>('saas.page.dashboard'));
      case 1:
        return Pricing01(
          key: const ValueKey<String>('saas.page.pricing'),
          onSelectPlan: (String plan) {},
        );
      case 2:
      default:
        return Settings01Flow(
          key: const ValueKey<String>('saas.page.settings'),
          onSignOut: widget.repository.signOut,
        );
    }
  }

  @override
  Widget build(BuildContext context) {
    return LayoutBuilder(
      builder: (BuildContext context, BoxConstraints constraints) {
        final bool wide = constraints.maxWidth >= 720;
        final Widget content = Expanded(child: _page(_index));
        final Widget bar = NavigationBar(
          key: const ValueKey<String>('saas.nav'),
          container: wide
              ? NavigationContainerType.rail
              : NavigationContainerType.bar,
          index: _index,
          onSelected: (int value) => setState(() => _index = value),
          children: _items,
        );
        if (wide) {
          return Row(
            key: const ValueKey<String>('saas.shell'),
            children: <Widget>[bar, content],
          );
        }
        return Column(
          key: const ValueKey<String>('saas.shell'),
          children: <Widget>[content, bar],
        );
      },
    );
  }
}
