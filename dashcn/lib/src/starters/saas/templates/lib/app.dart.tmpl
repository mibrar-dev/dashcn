// Root widget for the saas starter ({{appName}}).
//
// Auth first, then onboarding, then the responsive shell. Every flow reports
// through callbacks into [SaasRepository]; the kit holds no backend.
{{imports}}
import 'data/repository.dart';
import 'shell.dart';

/// Auth gate plus theme for the generated app.
class SaasApp extends StatefulWidget {
  /// Creates the app.
  const SaasApp({super.key});

  @override
  State<SaasApp> createState() => _SaasAppState();
}

class _SaasAppState extends State<SaasApp> {
  late final SaasRepository _repository = SaasRepository()
    ..addListener(_onChanged);

  void _onChanged() => setState(() {});

  @override
  void dispose() {
    _repository.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return DashcnApp(
      title: '{{appName}}',
      theme: {{themeBuild}}(Brightness.light),
      darkTheme: {{themeBuild}}(Brightness.dark),
      home: _home(),
    );
  }

  Widget _home() {
    if (!_repository.signedIn) {
      return Auth01Flow(
        onSignIn: (String email, String password) =>
            _repository.signIn(email, password),
        onSignUp: (String name, String email, String password) =>
            _repository.signUp(name, email, password),
        onVerifyOtp: (String code) => _repository.verifyOtp(code),
        onResetPassword: (String email) async {},
        onSocialSignIn: (String provider) async {},
        onOtpVerified: _repository.completeAuth,
      );
    }
    if (!_repository.onboarded) {
      return Onboarding01Flow(
        onSkip: _repository.skipOnboarding,
        onPermissionChanged: (bool granted) {},
        onFinished: () => _repository.completeOnboarding(true),
      );
    }
    return SaasShell(repository: _repository);
  }
}
