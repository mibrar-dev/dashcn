// Smoke test for the saas starter ({{appName}}).
//
// Walks the main routes: sign in (plus OTP) to the shell, then each tab.
import 'package:flutter/widgets.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:{{packageName}}/app.dart';

void main() {
  testWidgets('saas smoke: sign in to shell then each tab', (
    WidgetTester tester,
  ) async {
    await tester.pumpWidget(const SaasApp());
    await tester.pumpAndSettle();

    // Sign in.
    expect(find.text('Sign in'), findsWidgets);
    await tester.enterText(
      find.byKey(const ValueKey<String>('auth01.signin.email')),
      'ada@example.com',
    );
    await tester.enterText(
      find.byKey(const ValueKey<String>('auth01.signin.password')),
      'password123',
    );
    await tester.tap(find.text('Sign in').last);
    await tester.pumpAndSettle();

    // OTP step completes auth.
    await tester.enterText(
      find.byKey(const ValueKey<String>('auth01.otp.code')),
      '123456',
    );
    await tester.pumpAndSettle();

    // Onboarding: skip to the shell.
    final Finder skip = find.text('Skip');
    if (skip.evaluate().isNotEmpty) {
      await tester.tap(skip.first);
      await tester.pumpAndSettle();
    }
    final Finder getStarted = find.text('Get started');
    if (getStarted.evaluate().isNotEmpty) {
      await tester.tap(getStarted.first);
      await tester.pumpAndSettle();
    }
    // Permission ask resolves to the shell.
    final Finder allow = find.text('Allow notifications');
    if (allow.evaluate().isNotEmpty) {
      await tester.tap(allow.first);
      await tester.pumpAndSettle();
    }
    final Finder notNow = find.text('Not now');
    if (notNow.evaluate().isNotEmpty) {
      await tester.tap(notNow.first);
      await tester.pumpAndSettle();
    }

    expect(find.byKey(const ValueKey<String>('saas.shell')), findsOneWidget);

    // Pricing tab.
    await tester.tap(find.byKey(const ValueKey<String>('saas.tab.pricing')));
    await tester.pumpAndSettle();
    expect(
      find.byKey(const ValueKey<String>('saas.page.pricing')),
      findsOneWidget,
    );

    // Settings tab.
    await tester.tap(find.byKey(const ValueKey<String>('saas.tab.settings')));
    await tester.pumpAndSettle();
    expect(
      find.byKey(const ValueKey<String>('saas.page.settings')),
      findsOneWidget,
    );

    // Back to dashboard.
    await tester.tap(find.byKey(const ValueKey<String>('saas.tab.dashboard')));
    await tester.pumpAndSettle();
    expect(
      find.byKey(const ValueKey<String>('saas.page.dashboard')),
      findsOneWidget,
    );
  });
}
