{
  "id": "saas",
  "type": "starter",
  "name": "SaaS starter",
  "description": "Auth plus onboarding into a responsive shell with dashboard, pricing and settings.",
  "themePreset": "neutral",
  "platforms": ["ios", "android", "web", "macos", "windows", "linux"],
  "flows": ["auth-01", "onboarding-01", "settings-01"],
  "blocks": ["dashboard-01", "pricing-01"],
  "components": ["app", "navigation_bar"],
  "routes": [
    {"path": "/signin", "title": "Sign in", "kind": "flow", "ref": "auth-01"},
    {"path": "/welcome", "title": "Welcome", "kind": "flow", "ref": "onboarding-01"},
    {"path": "/dashboard", "title": "Dashboard", "kind": "block", "ref": "dashboard-01"},
    {"path": "/pricing", "title": "Pricing", "kind": "block", "ref": "pricing-01"},
    {"path": "/settings", "title": "Settings", "kind": "flow", "ref": "settings-01"}
  ],
  "files": [
    {"template": "starters/saas/templates/lib/main.dart.tmpl", "target": "lib/main.dart"},
    {"template": "starters/saas/templates/lib/app.dart.tmpl", "target": "lib/app.dart"},
    {"template": "starters/saas/templates/lib/data/repository.dart.tmpl", "target": "lib/data/repository.dart"},
    {"template": "starters/saas/templates/lib/shell.dart.tmpl", "target": "lib/shell.dart"},
    {"template": "starters/saas/templates/test/smoke_test.dart.tmpl", "target": "test/smoke_test.dart"}
  ],
  "tags": ["saas", "auth", "onboarding", "dashboard", "pricing", "settings"],
  "install": "dashcn create saas my_app"
}
