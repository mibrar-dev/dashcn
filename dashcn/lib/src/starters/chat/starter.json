{
  "id": "chat",
  "type": "starter",
  "name": "Chat starter",
  "description": "Auth into a tab bar with chat threads and settings.",
  "themePreset": "neutral",
  "platforms": ["ios", "android", "web", "macos", "windows", "linux"],
  "flows": ["auth-01", "chat-01", "settings-01"],
  "blocks": [],
  "components": ["app", "navigation_bar"],
  "routes": [
    {"path": "/signin", "title": "Sign in", "kind": "flow", "ref": "auth-01"},
    {"path": "/chat", "title": "Chat", "kind": "flow", "ref": "chat-01"},
    {"path": "/settings", "title": "Settings", "kind": "flow", "ref": "settings-01"}
  ],
  "files": [
    {"template": "starters/chat/templates/lib/main.dart.tmpl", "target": "lib/main.dart"},
    {"template": "starters/chat/templates/lib/app.dart.tmpl", "target": "lib/app.dart"},
    {"template": "starters/chat/templates/lib/data/repository.dart.tmpl", "target": "lib/data/repository.dart"},
    {"template": "starters/chat/templates/lib/shell.dart.tmpl", "target": "lib/shell.dart"},
    {"template": "starters/chat/templates/test/smoke_test.dart.tmpl", "target": "test/smoke_test.dart"}
  ],
  "tags": ["chat", "auth", "messages", "settings"],
  "install": "dashcn create chat my_app"
}
