// Tab bar shell for the chat starter.
//
// Two tabs host chat-01 and settings-01 with real callbacks into the app
// repository.
{{imports}}
import 'data/repository.dart';

/// Shell with chat and settings tabs.
class ChatShell extends StatefulWidget {
  /// Creates the shell.
  const ChatShell({super.key, required this.repository});

  /// App-owned state; sign-out flips it back to the auth flow.
  final ChatRepository repository;

  @override
  State<ChatShell> createState() => _ChatShellState();
}

class _ChatShellState extends State<ChatShell> {
  int _index = 0;

  List<NavigationBarItem> get _items => const <NavigationBarItem>[
    NavigationItem(
      key: ValueKey<String>('chat.tab.threads'),
      label: Text('Chat'),
      child: Icon(RadixIcons.chatBubble),
    ),
    NavigationItem(
      key: ValueKey<String>('chat.tab.settings'),
      label: Text('Settings'),
      child: Icon(RadixIcons.gear),
    ),
  ];

  Widget _page(int index) {
    switch (index) {
      case 0:
        return Chat01Flow(
          key: const ValueKey<String>('chat.page.threads'),
          onSend: (String threadId, String text) =>
              widget.repository.send(threadId, text),
          onRefresh: widget.repository.refresh,
        );
      case 1:
      default:
        return Settings01Flow(
          key: const ValueKey<String>('chat.page.settings'),
          onSignOut: widget.repository.signOut,
        );
    }
  }

  @override
  Widget build(BuildContext context) {
    return Column(
      key: const ValueKey<String>('chat.shell'),
      children: <Widget>[
        Expanded(child: _page(_index)),
        NavigationBar(
          key: const ValueKey<String>('chat.nav'),
          index: _index,
          onSelected: (int value) => setState(() => _index = value),
          children: _items,
        ),
      ],
    );
  }
}
