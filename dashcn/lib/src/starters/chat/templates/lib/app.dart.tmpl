// Root widget for the chat starter ({{appName}}).
//
// Auth first, then a tab bar with chat and settings. Every flow reports
// through callbacks into [ChatRepository]; the kit holds no backend.
{{imports}}
import 'data/repository.dart';
import 'shell.dart';

/// Auth gate plus theme for the generated app.
class ChatApp extends StatefulWidget {
  /// Creates the app.
  const ChatApp({super.key});

  @override
  State<ChatApp> createState() => _ChatAppState();
}

class _ChatAppState extends State<ChatApp> {
  late final ChatRepository _repository = ChatRepository()
    ..addListener(_onChanged);

  void _onChanged() => setState(() {});

  @override
  void dispose() {
    _repository.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return DashcnApp(
      title: '{{appName}}',
      theme: {{themeBuild}}(Brightness.light),
      darkTheme: {{themeBuild}}(Brightness.dark),
      home: _home(),
    );
  }

  Widget _home() {
    if (!_repository.signedIn) {
      return Auth01Flow(
        onSignIn: (String email, String password) =>
            _repository.signIn(email, password),
        onSignUp: (String name, String email, String password) =>
            _repository.signUp(name, email, password),
        onVerifyOtp: (String code) => _repository.verifyOtp(code),
        onResetPassword: (String email) async {},
        onSocialSignIn: (String provider) async {},
        onOtpVerified: _repository.completeAuth,
      );
    }
    return ChatShell(repository: _repository);
  }
}
