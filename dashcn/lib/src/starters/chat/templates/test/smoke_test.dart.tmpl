// Smoke test for the chat starter ({{appName}}).
//
// Walks the main routes: sign in (plus OTP) to the tab bar, then each tab.
import 'package:flutter/widgets.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:{{packageName}}/app.dart';

void main() {
  testWidgets('chat smoke: sign in to tabs', (WidgetTester tester) async {
    await tester.pumpWidget(const ChatApp());
    await tester.pumpAndSettle();

    expect(find.text('Sign in'), findsWidgets);
    await tester.enterText(
      find.byKey(const ValueKey<String>('auth01.signin.email')),
      'ada@example.com',
    );
    await tester.enterText(
      find.byKey(const ValueKey<String>('auth01.signin.password')),
      'password123',
    );
    await tester.tap(find.text('Sign in').last);
    await tester.pumpAndSettle();

    await tester.enterText(
      find.byKey(const ValueKey<String>('auth01.otp.code')),
      '123456',
    );
    await tester.pumpAndSettle();

    expect(find.byKey(const ValueKey<String>('chat.shell')), findsOneWidget);
    expect(
      find.byKey(const ValueKey<String>('chat.page.threads')),
      findsOneWidget,
    );

    await tester.tap(find.byKey(const ValueKey<String>('chat.tab.settings')));
    await tester.pumpAndSettle();
    expect(
      find.byKey(const ValueKey<String>('chat.page.settings')),
      findsOneWidget,
    );

    await tester.tap(find.byKey(const ValueKey<String>('chat.tab.threads')));
    await tester.pumpAndSettle();
    expect(
      find.byKey(const ValueKey<String>('chat.page.threads')),
      findsOneWidget,
    );
  });
}
