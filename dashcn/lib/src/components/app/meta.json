{
  "id": "app",
  "name": "App",
  "category": "Utilities (building blocks)",
  "listed": false,
  "description": "App shell over WidgetsApp that installs Theme, ComponentThemes, the overlay manager and dashcn localizations, plus the default text/icon scope.",
  "tier": "component",
  "install": "dashcn add app",
  "import": "import 'package:<your_app>/ui/dashcn/components/app/app.dart';",
  "tags": ["layout", "app", "shell", "bootstrap"],
  "deps": {
    "foundation": ["constants"],
    "theme": ["density", "theme"],
    "primitives": ["localizations", "overlay", "overlay_manager_layer"],
    "components": ["eye_dropper"]
  },
  "files": ["app.dart", "preview.dart"],
  "api": {
    "classes": ["DashcnApp"],
    "enums": [],
    "constants": []
  }
}
