{
  "id": "code_snippet",
  "name": "CodeSnippet",
  "category": "Typography & Media",
  "description": "Scrollable code block with syntax colouring, copy button and selectable text.",
  "tier": "component",
  "install": "dashcn add code_snippet",
  "import": "import 'package:<your_app>/ui/dashcn/components/code_snippet/code_snippet.dart';",
  "tags": [
    "display",
    "code",
    "snippet",
    "pre",
    "syntax"
  ],
  "deps": {
    "foundation": [
      "gap",
      "icons",
      "platform"
    ],
    "theme": [
      "color_tokens",
      "density",
      "motion",
      "theme"
    ],
    "primitives": [
      "clickable",
      "surface",
      "syntax_highlight",
      "text",
      "text_editing",
      "touch_hit_area"
    ],
    "components": []
  },
  "files": [
    "code_snippet.dart",
    "code_snippet_style.dart",
    "code_snippet_theme.dart",
    "preview.dart"
  ],
  "api": {
    "classes": [
      "CodeSnippet",
      "CodeSnippetTheme"
    ],
    "constants": [
      "codeSnippetDefaults",
      "codeSnippetThemeOverrides"
    ]
  },
  "theme": {
    "class": "CodeSnippetTheme",
    "userFile": "code_snippet_theme.dart",
    "defaults": "codeSnippetDefaults",
    "fields": {
      "background": "ThemedColor? - container fill, card token",
      "borderColor": "ThemedColor? - border color, border token",
      "borderWidth": "double? - scaled border width, 1",
      "borderRadius": "BorderRadiusGeometry? - null = ambient radiusLg",
      "padding": "EdgeInsetsGeometry? - density padding, wider on the end",
      "showCopyButton": "bool? - whether copy action renders by default",
      "copyIcon": "IconData? - idle copy icon, Lucide copy",
      "copiedIcon": "IconData? - feedback icon, Lucide check",
      "copyIconColor": "ThemedColor? - idle copy icon color, mutedForeground",
      "copiedIconColor": "ThemedColor? - copied icon color, primary",
      "actionSpacing": "double? - space between action items, 4",
      "copyFeedbackDuration": "Duration? - duration to show copied feedback, 1500ms"
    }
  }
}
