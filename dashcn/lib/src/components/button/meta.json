{
  "id": "button",
  "name": "Button",
  "category": "Buttons & Actions",
  "description": "Pressable action control with seven variants, five fixed sizes, an async idle/loading/success/failure status machine, plus a connected ButtonGroup.",
  "tier": "component",
  "install": "dashcn add button",
  "import": "import 'package:<your_app>/ui/dashcn/components/button/button.dart';",
  "tags": [
    "control",
    "button",
    "action",
    "group",
    "async",
    "loading"
  ],
  "deps": {
    "foundation": [
      "data",
      "gap",
      "geometry",
      "icons"
    ],
    "theme": [
      "color_tokens",
      "density",
      "density_tokens",
      "theme"
    ],
    "primitives": [
      "clickable",
      "touch_hit_area"
    ],
    "components": [
      "spinner"
    ]
  },
  "files": [
    "button.dart",
    "button_defaults.dart",
    "button_layout.dart",
    "button_status.dart",
    "button_status_content.dart",
    "button_status_style.dart",
    "button_style.dart",
    "button_theme.dart",
    "button_variant_style.dart",
    "button_group.dart",
    "preview.dart",
    "preview_status.dart"
  ],
  "api": {
    "classes": [
      "Button",
      "ButtonGroup",
      "ButtonGroupData",
      "ButtonTheme",
      "ButtonVariantStyle",
      "ButtonStatusStyle",
      "ButtonStatusController",
      "ButtonStatusIcon",
      "ButtonStatusLabel",
      "ButtonStatusContent",
      "ButtonPaintScheme",
      "ButtonSizeMetrics"
    ],
    "enums": [
      "ButtonVariant",
      "ButtonSize",
      "ButtonStatus",
      "DensityPreset"
    ],
    "functions": [
      "buttonMetricsFor",
      "buttonMetricsForTokens",
      "buttonInnerMin",
      "buttonStatusAnnouncement",
      "resolveButtonStatusIcon"
    ],
    "constants": [
      "buttonDefaultTextStyle",
      "buttonDefaults",
      "buttonStatusDefaults",
      "buttonDefaultStatusReset",
      "buttonDefaultStatusTransition",
      "buttonDefaultStatusIconSize",
      "buttonDefaultSpinnerSize",
      "buttonDefaultSuccessIcon",
      "buttonDefaultFailureIcon",
      "buttonDefaultLoadingIcon",
      "buttonThemeOverrides"
    ]
  },
  "theme": {
    "class": "ButtonTheme",
    "userFile": "button_theme.dart",
    "defaults": "buttonDefaults",
    "fields": {
      "primary": "ButtonVariantStyle? - filled high-emphasis row",
      "secondary": "ButtonVariantStyle? - filled lower-emphasis row",
      "outline": "ButtonVariantStyle? - 1px input border row",
      "ghost": "ButtonVariantStyle? - hover-fill-only row",
      "link": "ButtonVariantStyle? - underlined-on-hover row",
      "text": "ButtonVariantStyle? - muted label row",
      "destructive": "ButtonVariantStyle? - danger row",
      "status": "ButtonStatusStyle? - cross-variant async status visuals",
      "status.spinnerSize": "double? - loading spinner diameter, 16",
      "status.statusIconSize": "double? - success/failure glyph size, 16",
      "status.successIcon": "IconData? - success glyph, check",
      "status.failureIcon": "IconData? - failure glyph, x",
      "status.loadingIcon": "IconData? - static loading glyph under reduced motion, loaderCircle",
      "status.successColor": "ThemedColor? - null keeps the button foreground",
      "status.failureColor": "ThemedColor? - null uses destructive (foreground for the destructive variant)",
      "status.loadingColor": "ThemedColor? - null keeps the button foreground",
      "status.transitionDuration": "Duration? - icon/label cross-fade, 175ms",
      "background": "StateValue<ThemedColor>? - per-state fill",
      "foreground": "StateValue<ThemedColor>? - per-state label/icon colour",
      "borderColor": "StateValue<ThemedColor>? - null draws no border",
      "borderWidth": "double? - used when borderColor resolves",
      "decoration": "StateValue<TextDecoration>? - link underline",
      "padding": "EdgeInsetsGeometry? - null = size table, density-scaled",
      "textStyle": "TextStyle? - null = size table"
    }
  }
}
