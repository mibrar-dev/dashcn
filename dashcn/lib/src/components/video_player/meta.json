{
  "id": "video_player",
  "name": "Video Player",
  "category": "Typography & Media",
  "description": "SPEC glass control bar (title header, 10s skips, speed/captions more-menu, auto-hide), 64px centre button, live badge and camera fallback.",
  "tier": "component",
  "install": "dashcn add video_player",
  "import": "import 'package:<your_app>/ui/dashcn/components/video_player/video_player.dart';",
  "tags": [
    "media",
    "video",
    "player",
    "scrub",
    "captions",
    "fullscreen"
  ],
  "deps": {
    "foundation": [
      "constants",
      "icons"
    ],
    "theme": [
      "color_tokens",
      "density",
      "theme"
    ],
    "primitives": [
      "focus_outline",
      "motion",
      "surface",
      "tap_target"
    ],
    "components": []
  },
  "files": [
    "video_player.dart",
    "video_player_buttons.dart",
    "video_player_controller.dart",
    "video_player_controls.dart",
    "video_player_header.dart",
    "video_player_menu.dart",
    "video_player_scrub.dart",
    "video_player_style.dart",
    "video_player_theme.dart",
    "video_player_volume.dart",
    "preview.dart"
  ],
  "api": {
    "classes": [
      "VideoPlayer",
      "VideoControlsBar",
      "VideoScrubBar",
      "VideoPlayerTheme",
      "VideoPlaybackController",
      "VideoSource",
      "VideoCaptionCue",
      "FakeVideoPlaybackController",
      "VolumePainter"
    ],
    "typedefs": [
      "VideoPartBuilder",
      "VideoScrubChanged"
    ],
    "functions": [
      "formatMediaTime",
      "videoIconButton",
      "videoPlayButton",
      "videoBarHeader",
      "videoMoreButton",
      "videoMenuSection",
      "videoVolumeCluster"
    ],
    "constants": [
      "videoPlayerDefaults",
      "videoPlayerThemeOverrides",
      "kVideoSpeeds",
      "demoVideoSources"
    ]
  },
  "theme": {
    "class": "VideoPlayerTheme",
    "userFile": "video_player_theme.dart",
    "defaults": "videoPlayerDefaults",
    "fields": {
      "background": "ThemedColor? - frame fill, black",
      "scrim": "ThemedColor? - control bar scrim",
      "foreground": "ThemedColor? - icons and labels on the scrim, white",
      "accent": "ThemedColor? - played fill, primary",
      "track": "ThemedColor? - unplayed track, translucent white",
      "buffered": "ThemedColor? - buffered fill, translucent white",
      "thumb": "ThemedColor? - scrub thumb, white",
      "borderRadius": "BorderRadiusGeometry? - null = 18px frame",
      "controlsPadding": "EdgeInsetsGeometry? - null = 10/6",
      "controlSize": "double? - centre play button diameter, 64",
      "iconSize": "double? - bar button icons, 20",
      "trackHeight": "double? - scrub track height, 4",
      "timeTextStyle": "TextStyle? - time labels",
      "captionsTextStyle": "TextStyle? - captions overlay",
      "surfaceOpacity": "double? - control bar opacity leg",
      "surfaceBlur": "double? - control bar blur leg",
      "fadeDuration": "Duration? - controls fade, 150ms",
      "controlsTimeout": "Duration? - reserved auto-hide delay, 3s"
    }
  }
}
