{
  "id": "signature_pad",
  "name": "Signature Pad",
  "category": "Forms & Inputs",
  "description": "Freehand signature capture with smoothed strokes, speed-based width, undo/redo/clear and PNG/SVG export.",
  "tier": "component",
  "install": "dashcn add signature_pad",
  "import": "import 'package:<your_app>/ui/dashcn/components/signature_pad/signature_pad.dart';",
  "tags": [
    "form",
    "input",
    "signature",
    "draw",
    "pad",
    "export"
  ],
  "deps": {
    "foundation": [],
    "theme": [
      "color_tokens",
      "theme"
    ],
    "primitives": [],
    "components": []
  },
  "files": [
    "signature_pad.dart",
    "signature_pad_controller.dart",
    "signature_pad_style.dart",
    "signature_pad_theme.dart",
    "preview.dart"
  ],
  "api": {
    "classes": [
      "SignaturePad",
      "SignaturePadController",
      "SignaturePadPainter",
      "SignaturePadTheme",
      "SignaturePoint",
      "SignatureStroke"
    ],
    "enums": [],
    "functions": [
      "paintSignatureStrokes",
      "signatureStrokeWidths"
    ],
    "constants": [
      "signaturePadDefaults",
      "signaturePadThemeOverrides"
    ]
  },
  "theme": {
    "class": "SignaturePadTheme",
    "userFile": "signature_pad_theme.dart",
    "defaults": "signaturePadDefaults",
    "fields": {
      "strokeColor": "ThemedColor? - ink colour, default foreground",
      "background": "ThemedColor? - pad surface, default card",
      "borderColor": "ThemedColor? - pad outline, default border",
      "borderWidth": "double? - outline thickness, default 1",
      "borderRadius": "double? - corner radius, default 8",
      "strokeWidth": "double? - rest width, default 3",
      "minStrokeWidth": "double? - at-speed width, default 1",
      "variableWidth": "bool? - narrow with speed, default true"
    }
  }
}
