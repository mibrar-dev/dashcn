{
  "id": "command",
  "name": "Command",
  "category": "Menus",
  "description": "Command palette with a debounced async result stream, keyboard navigation and a dialog entry point.",
  "tier": "component",
  "install": "dashcn add command",
  "import": "import 'package:<your_app>/ui/dashcn/components/command/command.dart';",
  "tags": [
    "control",
    "command",
    "palette",
    "search",
    "keyboard"
  ],
  "deps": {
    "foundation": [
      "icons/lucide_icons"
    ],
    "theme": [
      "color_tokens",
      "density",
      "theme"
    ],
    "primitives": [
      "input_features",
      "localizations",
      "search",
      "subfocus_scope",
      "surface",
      "text"
    ],
    "components": [
      "button",
      "dialog",
      "input"
    ]
  },
  "files": [
    "command.dart",
    "command_style.dart",
    "command_theme.dart",
    "preview.dart"
  ],
  "api": {
    "classes": [
      "Command",
      "CommandEmpty",
      "CommandTheme",
      "CommandShortcut"
    ],
    "types": [
      "CommandBuilder",
      "CommandErrorBuilder"
    ],
    "functions": [
      "showCommandDialog",
      "rankCommandLabels"
    ],
    "constants": [
      "commandDefaults",
      "commandDefaultItemPadding",
      "commandThemeOverrides"
    ]
  },
  "theme": {
    "class": "CommandTheme",
    "userFile": "command_theme.dart",
    "defaults": "commandDefaults",
    "fields": {
      "background": "ThemedColor? - palette surface, default popover",
      "foreground": "ThemedColor? - item title colour",
      "mutedForeground": "ThemedColor? - secondary text",
      "borderColor": "ThemedColor? - surface border",
      "borderWidth": "double? - null draws no border at 0",
      "borderRadius": "BorderRadiusGeometry? - null = radiusLg",
      "padding": "EdgeInsetsGeometry? - content padding, default 4",
      "itemHighlight": "ThemedColor? - focused row fill, default accent",
      "itemHighlightForeground": "ThemedColor? - focused row content",
      "itemPadding": "EdgeInsetsGeometry? - row padding, default 8/6",
      "shadows": "List<BoxShadow>? - surface shadows; empty draws none",
      "maxWidth": "double? - dialog width, default 512 (max-w-lg)",
      "maxHeight": "double? - dialog height, default 349"
    }
  }
}
