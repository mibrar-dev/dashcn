{
  "id": "action_sheet",
  "name": "ActionSheet",
  "category": "Overlays",
  "description": "A bottom sheet of actions with title and message, destructive and cancel actions, icons, scrollable list, drag to dismiss, and a centered dialog variant on wide screens.",
  "tier": "component",
  "listed": true,
  "install": "dashcn add action_sheet",
  "import": "import 'package:<your_app>/ui/dashcn/components/action_sheet/action_sheet.dart';",
  "tags": ["overlay", "sheet", "actions", "modal"],
  "deps": {
    "foundation": ["icons", "platform"],
    "theme": ["color_tokens", "density", "density_tokens", "theme"],
    "primitives": ["clickable", "surface", "touch_hit_area"],
    "components": ["dialog", "drawer"]
  },
  "files": [
    "action_sheet.dart",
    "action_sheet_action.dart",
    "action_sheet_row.dart",
    "action_sheet_show.dart",
    "action_sheet_style.dart",
    "action_sheet_theme.dart",
    "preview.dart"
  ],
  "api": {
    "classes": ["ActionSheet", "ActionSheetAction", "ActionSheetRow", "ActionSheetTheme", "ActionSheetStyle"],
    "functions": ["showActionSheet"],
    "constants": ["actionSheetDefaults", "actionSheetThemeOverrides"]
  },
  "theme": {
    "class": "ActionSheetTheme",
    "userFile": "action_sheet_theme.dart",
    "defaults": "actionSheetDefaults",
    "fields": {
      "backgroundColor": "ThemedColor? - sheet background",
      "titleStyle": "TextStyle? - title text style",
      "messageStyle": "TextStyle? - message text style",
      "destructiveColor": "ThemedColor? - destructive action colour",
      "cancelColor": "ThemedColor? - cancel action colour",
      "dividerColor": "ThemedColor? - divider colour",
      "padding": "EdgeInsetsGeometry? - sheet padding",
      "borderRadius": "BorderRadius? - sheet radius",
      "maxWidth": "double? - desktop max width (320 compact)",
      "rowMinHeight": "double? - row min height (tokens.rowMinHeight)",
      "iconSize": "double? - row icon size (tokens.iconSize)",
      "titleSpacing": "double? - title gap (tokens.gap/2)",
      "messageSpacing": "double? - header gap (tokens.gap)",
      "surfaceOpacity": "double? - frosted opacity",
      "surfaceBlur": "double? - frosted blur",
      "transitionDuration": "Duration? - open animation"
    }
  }
}
