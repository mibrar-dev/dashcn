{
  "id": "filter_bar",
  "name": "FilterBar",
  "category": "Layout",
  "description": "Search, sort, date-range, custom filters and chips in one bar, with a clear action and a mobile sheet presentation; backed by a typed filter engine.",
  "tier": "component",
  "install": "dashcn add filter_bar",
  "import": "import 'package:<your_app>/ui/dashcn/components/filter_bar/filter_bar.dart';",
  "tags": [
    "layout",
    "filters",
    "search",
    "sort",
    "sheet",
    "menu",
    "density"
  ],
  "deps": {
    "foundation": [
      "gap",
      "icons"
    ],
    "theme": [
      "theme"
    ],
    "primitives": [
      "filter_core",
      "form_core",
      "input_features",
      "localizations",
      "overlay",
      "popover",
      "surface"
    ],
    "components": [
      "button",
      "chip",
      "date_picker",
      "drawer",
      "input",
      "select"
    ]
  },
  "files": [
    "filter_bar.dart",
    "filter_bar_body.dart",
    "filter_bar_controls.dart",
    "filter_bar_inline.dart",
    "filter_bar_layout.dart",
    "filter_bar_menu.dart",
    "filter_bar_overflow.dart",
    "filter_bar_search.dart",
    "filter_bar_sheet.dart",
    "filter_bar_style.dart",
    "filter_bar_theme.dart",
    "filter_bar_triggers.dart",
    "preview.dart"
  ],
  "preview": {
    "placement": "top"
  },
  "api": {
    "classes": [
      "FilterBar",
      "FilterBarStyle",
      "FilterBarTheme",
      "FilterBarSheetScaffold",
      "FilterBarOverflowMenu",
      "FilterBarSearchField",
      "FilterBarSortControl",
      "FilterBarDateControl",
      "FilterBarClearButton",
      "FilterBarSheetTrigger",
      "FilterBarController",
      "FilterState",
      "FilterChipData",
      "FilterDateRange",
      "FilterSortOption",
      "FilterMatcher",
      "FilterMatcherOption",
      "FilterField",
      "FilterBinding",
      "TypedFilterBinding",
      "FilterCustomFilter",
      "FilterClearPolicy",
      "FilterGroup",
      "FilterBarGroupedContent"
    ],
    "enums": [
      "FilterBarPresentation"
    ],
    "typedefs": [
      "FilterBarOverflowTrigger"
    ],
    "functions": [
      "openFilterBarMenu",
      "openFilterBarSheet"
    ],
    "constants": ["filterBarThemeOverrides"],
    "providedByPrimitives": {
      "filter_core": ["filterBarDefaults", "FilterMatchers"]
    }
  },
  "theme": {
    "class": "FilterBarTheme",
    "userFile": "filter_bar_theme.dart",
    "defaults": "filterBarDefaults",
    "fields": {
      "spacing": "double? - gap between controls, 8 by default",
      "runSpacing": "double? - gap between wrapped runs, 8 by default",
      "searchWidth": "double? - search field width, 220 by default",
      "controlWidth": "double? - sort/date control width, 180 by default",
      "controlHeight": "double? - control height override (32 compact, 40 comfortable, 48 touch)",
      "iconSize": "double? - icon size override (16 compact, 20 comfortable, 24 touch)",
      "dense": "bool? - compact padding and small buttons, false by default"
    }
  }
}
