{
  "id": "overflow_marquee",
  "name": "Overflow Marquee",
  "category": "Layout",
  "description": "Continuous auto-scrolling content loop, horizontally or vertically, with soft edge fades, hover/focus pause, and reduced-motion support.",
  "tier": "component",
  "install": "dashcn add overflow_marquee",
  "import": "import 'package:<your_app>/ui/dashcn/components/overflow_marquee/overflow_marquee.dart';",
  "tags": [
    "layout",
    "marquee",
    "ticker",
    "scroll",
    "animation"
  ],
  "deps": {
    "foundation": [
      "geometry"
    ],
    "theme": [
      "color_tokens",
      "theme"
    ],
    "primitives": [],
    "components": []
  },
  "files": [
    "overflow_marquee.dart",
    "overflow_marquee_controller.dart",
    "overflow_marquee_render.dart",
    "overflow_marquee_style.dart",
    "overflow_marquee_theme.dart",
    "preview.dart"
  ],
  "api": {
    "classes": [
      "OverflowMarquee",
      "OverflowMarqueeTheme",
      "MarqueeController",
      "MarqueeSurface"
    ],
    "enums": [
      "AxisDirectional"
    ],
    "constants": [
      "overflowMarqueeDefaults",
      "overflowMarqueeThemeOverrides"
    ]
  },
  "theme": {
    "class": "OverflowMarqueeTheme",
    "userFile": "overflow_marquee_theme.dart",
    "defaults": "overflowMarqueeDefaults",
    "fields": {
      "direction": "AxisDirectional? - start | end | up | down (RTL-aware)",
      "speed": "double? - scroll speed in pixels per second",
      "gap": "double? - gap between repeating copies in continuous loop",
      "pauseOnHover": "bool? - pause animation on pointer hover",
      "pauseOnFocus": "bool? - pause animation on keyboard focus",
      "loop": "bool? - whether marquee loops continuously",
      "duration": "Duration? - legacy run time",
      "delayDuration": "Duration? - pause at each end",
      "step": "double? - pixels covered per duration",
      "fadePortion": "double? - edge fade fraction of the visible extent, clamped 0..0.5",
      "curve": "Curve? - easing of each run"
    }
  }
}
