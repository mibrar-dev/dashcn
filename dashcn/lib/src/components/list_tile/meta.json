{
  "id": "list_tile",
  "name": "ListTile",
  "category": "Data Display",
  "description": "A single-line to three-line list row with leading, title, subtitle and trailing slots, dense/comfortable sizing, selected and disabled states, tap and long-press, plus a grouped list helper.",
  "tier": "component",
  "listed": true,
  "install": "dashcn add list_tile",
  "import": "import 'package:<your_app>/ui/dashcn/components/list_tile/list_tile.dart';",
  "tags": ["list", "tile", "row", "dense", "grouped"],
  "deps": {
    "foundation": ["gap", "icons"],
    "theme": ["color_tokens", "density", "theme"],
    "primitives": ["clickable"],
    "components": []
  },
  "files": [
    "list_tile.dart",
    "list_tile_style.dart",
    "list_tile_theme.dart",
    "preview.dart"
  ],
  "api": {
    "classes": ["ListTile", "ListTileGroup", "ListTileTheme", "ListTileStyle"],
    "constants": ["listTileDefaults", "listTileThemeOverrides"]
  },
  "theme": {
    "class": "ListTileTheme",
    "userFile": "list_tile_theme.dart",
    "defaults": "listTileDefaults",
    "fields": {
      "padding": "EdgeInsetsGeometry? - row padding",
      "titleStyle": "TextStyle? - title text style",
      "subtitleStyle": "TextStyle? - subtitle text style",
      "selectedColor": "ThemedColor? - selected fill",
      "tileColor": "ThemedColor? - resting fill",
      "iconColor": "ThemedColor? - leading icon colour",
      "textColor": "ThemedColor? - title colour",
      "subtitleColor": "ThemedColor? - subtitle colour"
    }
  }
}
