{
  "id": "checkout-01",
  "type": "flow",
  "name": "Checkout 01",
  "description": "Cart with swipe-to-delete rows, an address bottom sheet, payment and a success screen.",
  "viewport": "mobile",
  "screens": [
    "Cart",
    "Address sheet",
    "Payment",
    "Success"
  ],
  "entry": "flow.dart",
  "files": [
    "flow.dart",
    "screens/cart_screen.dart",
    "screens/address_sheet.dart",
    "screens/payment_screen.dart",
    "screens/success_screen.dart",
    "README.md"
  ],
  "deps": {
    "foundation": [
      "gap",
      "icons"
    ],
    "theme": [
      "theme"
    ],
    "primitives": [
      "localizations"
    ],
    "components": [
      "button",
      "card",
      "drawer_container",
      "empty_state",
      "form",
      "input",
      "page_route",
      "pinned_sheet",
      "swipe_actions"
    ],
    "blocks": []
  },
  "tags": [
    "checkout",
    "cart",
    "payment",
    "sheet",
    "shop"
  ],
  "install": "dashcn add flow:checkout-01",
  "import": "import 'package:<your_app>/ui/dashcn/flows/checkout-01/flow.dart';"
}
