{
  "id": "chat-01",
  "type": "flow",
  "name": "Chat 01",
  "description": "Thread list with swipe actions and pull-to-refresh, a conversation with composer, and an attachments sheet.",
  "viewport": "mobile",
  "screens": [
    "Threads",
    "Conversation",
    "Attachments sheet"
  ],
  "entry": "flow.dart",
  "files": [
    "flow.dart",
    "screens/thread_list_screen.dart",
    "screens/conversation_screen.dart",
    "screens/attachments_sheet.dart",
    "README.md"
  ],
  "deps": {
    "foundation": [
      "gap"
    ],
    "theme": [
      "theme"
    ],
    "primitives": [
      "localizations"
    ],
    "components": [
      "avatar",
      "button",
      "card",
      "chat",
      "drawer_container",
      "empty_state",
      "input",
      "page_route",
      "pinned_sheet",
      "refresh_trigger",
      "swipe_actions"
    ],
    "blocks": []
  },
  "tags": [
    "chat",
    "messages",
    "threads",
    "composer"
  ],
  "install": "dashcn add flow:chat-01",
  "import": "import 'package:<your_app>/ui/dashcn/flows/chat-01/flow.dart';"
}
