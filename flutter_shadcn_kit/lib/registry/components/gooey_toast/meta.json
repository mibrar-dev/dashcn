{
  "id": "gooey_toast",
  "name": "Gooey Toast",
  "category": "Overlays",
  "description": "Gooey-style transient notifications: a compact tab-shaped pill that grows a wider body below it through concave shoulders, anchored to the window edge.",
  "tier": "component",
  "install": "flutter_shadcn add gooey_toast",
  "import": "import 'package:<your_app>/ui/shadcn/components/gooey_toast/gooey_toast.dart';",
  "tags": [
    "overlay",
    "notification",
    "toast",
    "gooey",
    "metaball"
  ],
  "deps": {
    "foundation": [
      "icons"
    ],
    "theme": [
      "color_tokens",
      "theme"
    ],
    "primitives": [
      "animation",
      "color_math",
      "gooey",
      "toast_queue"
    ],
    "components": [
      "button",
      "divider",
      "input"
    ]
  },
  "files": [
    "gooey_toast.dart",
    "gooey_toast_controller.dart",
    "gooey_toast_options.dart",
    "gooey_toast_payload.dart",
    "gooey_toast_stack.dart",
    "gooey_toast_style.dart",
    "gooey_toast_theme.dart",
    "preview.dart"
  ],
  "api": {
    "classes": [
      "GooeyAutopilot",
      "GooeyToastAction",
      "GooeyToastCard",
      "GooeyToastController",
      "GooeyToastDetails",
      "GooeyToastLayer",
      "GooeyToastOptions",
      "GooeyToastRecord",
      "GooeyToastScope",
      "GooeyToastPayload"
    ],
    "enums": [
      "GooeyToastState",
      "GooeyToastPosition",
      "GooeyToastExpandDirection",
      "GooeyToastAnimationStyle",
      "GooeyToastShapeStyle",
      "GooeyToastBodyAnimationStyle",
      "GooeyToastNewToastBehavior"
    ],
    "functions": [
      "gooeyToastControllerOf",
      "gooeyToastThemeOf",
      "showGooeyToast",
      "ensureToneContrast"
    ],
    "constants": [
      "gooeyToastDefaults",
      "gooeyToastThemeOverrides",
      "gooeyTitleTextStyle",
      "gooeyDescriptionTextStyle",
      "gooeySuccessTone",
      "gooeyWarningTone",
      "gooeyInfoTone",
      "gooeyActionTone",
      "gooeyLoadingTone",
      "kGooeyDefaultDuration",
      "kGooeyTransitionCompactGap"
    ]
  },
  "theme": {
    "class": "GooeyToastTheme",
    "userFile": "gooey_toast_theme.dart",
    "defaults": "gooeyToastDefaults",
    "fields": {
      "width": "double? - surface width (350)",
      "fill": "ThemedColor? - surface fill (light near-white #F7F8FA)",
      "roundness": "double? - base corner roundness before the shape style (18)",
      "titleStyle": "TextStyle? - compact label; null uses the state tone",
      "descriptionStyle": "TextStyle? - expanded body text",
      "descriptionColor": "ThemedColor? - expanded body text colour (mutedForeground)",
      "duration": "Duration? - default auto-dismiss (6s)",
      "animationStyle": "GooeyToastAnimationStyle? - open/close profile (sileo)",
      "shapeStyle": "GooeyToastShapeStyle? - corner profile (defaultShape)",
      "bodyAnimationStyle": "GooeyToastBodyAnimationStyle? - body content profile (fade)",
      "enableGooeyBlur": "bool? - metaball blur pass (true)",
      "compactMorph": "GooeyCompactMorph? - in-place compact morph policy",
      "successTone": "ThemedColor? - success accent (fixed gooeySuccessTone green)",
      "loadingTone": "ThemedColor? - loading accent (fixed gooeyLoadingTone grey)",
      "errorTone": "ThemedColor? - error accent (fixed gooeyErrorTone red)",
      "warningTone": "ThemedColor? - warning accent (fixed gooeyWarningTone amber)",
      "infoTone": "ThemedColor? - info accent (fixed gooeyInfoTone blue)",
      "actionTone": "ThemedColor? - action accent (fixed gooeyActionTone indigo)"
    }
  }
}
